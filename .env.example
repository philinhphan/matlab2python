# OpenAI API (used when --provider openai, the default)
OPENAI_API_KEY=your-key-here

# BMW LLM API (used when --provider bmw)
# Get CLIENT_ID and CLIENT_SECRET from WebEAM, then run:
#   python -c "from converter.bmw_auth import get_access_token; t,e=get_access_token('CLIENT_ID','CLIENT_SECRET'); print(t)"
LLM_API_PROD_KEY=your-bmw-api-key-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here
# Optional: cache a pre-fetched token to skip the auth round-trip
LLM_ACCESS_TOKEN=
LLM_ACCESS_TOKEN_EXP=
