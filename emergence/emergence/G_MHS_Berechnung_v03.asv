function [] = G_MHS_Berechnung_v03(Par)

% #########################################################################
% ###########      Variable Fahrzeug- und Akustikdaten          ###########
% #########################################################################
clc

% Name der Berechnung
Mic_Pos_Name = Par.Mic_Pos_Name;
Name_berechnung_plot = [Par.Name_MHS_Kurven_plot ' ' Mic_Pos_Name];
Name_berechnung_save = [Par.Name_MHS_Kurven_save '_' Mic_Pos_Name];

% Geschwindigkeiten der Wind-Roll-Geräusch Messungen
v = Par.v;
v = v';

% Bezeichnung Position Mikrophon
if strcmp(Mic_Pos_Name,'VL_li') > 0
    Mic_Pos = 'Mic__VL_li_Ohr_S';
elseif strcmp(Mic_Pos_Name,'VL_re') > 0
    Mic_Pos = 'Mic__VL_re_Ohr_S';
elseif strcmp(Mic_Pos_Name,'VR_li') > 0
    Mic_Pos = 'Mic__VR_li_Ohr_S';
elseif strcmp(Mic_Pos_Name,'VR_re') > 0
    Mic_Pos = 'Mic__VR_re_Ohr_S';    
elseif strcmp(Mic_Pos_Name,'HL_li') > 0
    Mic_Pos = 'Mic__HL_li_Ohr_S';
elseif strcmp(Mic_Pos_Name,'HL_re') > 0
    Mic_Pos = 'Mic__HL_re_Ohr_S';    
elseif strcmp(Mic_Pos_Name,'HR_li') > 0
    Mic_Pos = 'Mic__HR_li_Ohr_S';
elseif strcmp(Mic_Pos_Name,'HR_re') > 0
    Mic_Pos = 'Mic__HR_re_Ohr_S';
end

%% ########################################################################
%  ###########     Berechnung der Geschwindigkeits-Ziele        ###########
%  ########################################################################

% Input lesen (Wind-Roll-Geräusch in dBA)

display(['Bitte Wind-Roll-Geräusch Daten auswählen für Mikro: ' Mic_Pos_Name]);
[messung_data,messung_path,Filter_Index] = uigetfile('Wind Roll Gerausch\');
% the actual file to analyze is copied to Wind Roll Gerausch as WRG_Ziele.mat
%copyfile([messung_path messung_data],'Wind Roll Gerausch\WRG_Ziele.mat');

meas_f = load([messung_path messung_data]);

[fy,Lmhs_array,ZArrayV,freq_max,freq_min,save_path,specs,freq] = mhs_core(meas_f, Mic_Pos, Name_berechnung_save, Name_berechnung_plot, v);


%% Plot Interpolierte Geschwindigkeitsziele

cmap = colormap(jet(length(v)));
legendInfo = cell(1,length(v));
f = figure;
for kk = 1:length(v)
    semilogx(ZArrayV(:,2*kk),ZArrayV(:,2*kk+1),'Color',cmap(kk,:),'LineWidth',2);
    hold on;
    legendInfo{kk} = [num2str(v(kk)) ' km/h'];
end
screen_size = get(0,'ScreenSize');
set(gcf, 'Position', [10 31 0.99*screen_size(3) 0.85*screen_size(4)]);
set(gca,'XScale','lin','FontSize',14);
h_legend=legend(legendInfo,'Location','Best');
set(h_legend,'FontSize',10);
grid on; xlabel('Frequenz [Hz]','FontSize',14);ylabel('Innenraum Schallpegel Mithörschwelle [dB(A)]','FontSize',14);
title(['Geschwindigkeitsziele ' Name_berechnung_plot],'FontSize',18,'interpreter','none');
hold off;
savefig([save_path Name_berechnung_save '_Innenraum_Geschwindigkeitsziele']);
set(gcf,'PaperPositionMode','auto');
print(f,[save_path Name_berechnung_save '_Innenraum_Geschwindigkeitsziele'],'-dmeta','-r0');


%% #########################################################################
%  ## Innenraum-Ziele speichern als Input für die Verzielung der Quelle   ##
%  #########################################################################

save([save_path Name_berechnung_save '_Ziele_Innenraum.mat'],'fy','Lmhs_array','ZArrayV','v','freq_max','freq_min','save_path','specs','freq');
close all

end

function [fy,Lmhs_array,ZArrayV,freq_max,freq_min,save_path,specs,freq] = mhs_core(meas_f, Mic_Pos, Name_berechnung_save, Name_berechnung_plot, v) 
%% ########################################################################
%  ###########     Berechnung der Geschwindigkeits-Ziele        ###########
%  ########################################################################

mkdir('MHS Kurven',Name_berechnung_save);
save_path = ['MHS Kurven\' Name_berechnung_save '\'];

% Datenzuweisung

freq = meas_f.([Mic_Pos '_X']); 
specs = zeros(length(freq),length(v));

for jj = 1:length(v)
    if jj == 1
        specs(:,jj) = 20*log10(meas_f.(Mic_Pos)/(2*10^-5));
    elseif jj < 11
        specs(:,jj) = 20*log10(meas_f.([Mic_Pos '_0' num2str(jj-1)])/(2*10^-5));
    else
        specs(:,jj) = 20*log10(meas_f.([Mic_Pos '_' num2str(jj-1)])/(2*10^-5));
    end
end


% Berechnungen

[s_row,s_col] = size(specs);
delta_f = (freq(2)-freq(1)+freq(3)-freq(2)+freq(4)-freq(3))/3;
delta_f_e = delta_f*1.5;

ii = 1;
while freq(ii)<90
    ii = ii+1;
end
freq_min = freq(ii);     % Norm ab 90 Hz gültig
ii_freq_min = ii;

%fak_dens = 1/sqrt(delta_f);

% Berechnung Frequenzgruppen delta_f_c und Verdeckungsmaß av und
% A-Bewertung

delta_f_c = zeros(s_row,1);   % Bandbreite
av = zeros(s_row,1);          % Verdeckungsmaß
f1 = zeros(s_row,1);          % Untere Frequenz der Frequenzgruppe
f2 = zeros(s_row,1);          % Obere Frequenz der Frequenzgruppe
abew = zeros(s_row,1);        % A-Bewertung
freq_max = zeros(1,1);        % maximale zu untersuchende Frequenz

for ii = 1:s_row
    
    if freq(ii) >= freq_min
        av(ii) = -2 - log10(1 + (freq(ii)/502)^2.5);
        delta_f_c(ii) = 25 + 75*(1 + 1.4*((freq(ii)/1000)^2))^0.69;
        f1(ii) = -delta_f_c(ii)/2 + sqrt(delta_f_c(ii)^2 + 4*freq(ii)^2)/2;
        f2(ii) = f1(ii) + delta_f_c(ii);
        abew(ii) = 2 + 20*log10((12194^2*freq(ii)^4) / ((freq(ii)^2 + 20.6^2) * (freq(ii)^2 + 107.7^2)^0.5 * (freq(ii)^2 + 737.9^2)^0.5 * (freq(ii)^2 + 12194^2)));
    else
    end
    
    if f2(ii) <= freq(end) && freq(end) - f2(ii) <= 4
        freq_max = freq(ii); % maximale zu untersuchende Frequenz entspricht der Mittenfrequenz, deren obere Gruppeneckfrequenz (f2) noch innerhalb des gemessenen Spektrums liegt
        iq = ii - ii_freq_min + 1; % Vektorlänge des Analysebereichs vorgeben
    else
    end
    
end

fy = zeros(iq,1); % Frequenz Analysebereich
f1y = zeros(iq,1); % untere Eckfrequenz Analysebereich
f2y = zeros(iq,1); % untere Eckfrequenz Analysebereich
avy = zeros(iq,1);
abewy = zeros(iq,1);
delta_f_cy = zeros(iq,1);
id = 1;
for jj = 1:s_row
    if freq(jj) >= freq_min && freq(jj) <= freq_max
        fy(id) = freq(jj);
        f1y(id) = f1(jj);
        f2y(id) = f2(jj);
        avy(id) = av(jj);
        abewy(id) = abew(jj);
        delta_f_cy(id) = delta_f_c(jj);
        id = id + 1;
    else
    end
end

% Berechnung mittlerer Schmallbandpegel der Frequenzgruppe Ls für jede
% Frequenz aller Spektren
hWait = waitbar(0,'Berechne Mithörschwellen ...');

Lmhs_array = zeros(iq,s_col);
for rr = 1:s_col
    waitbar(rr/s_col);
    specy = specs(:,rr);
    Ls_temp = 0;
    Ls = zeros(iq,1);
    Lg = zeros(iq,1);
    Lmhs = zeros(iq,1);
    M = 0;
    for ll = 1:iq
        for pp = 1:s_row %für originalen Frequenz- und Pegelvektor
            if freq(pp) >= f1y(ll) && freq(pp) <=f2y(ll)
                M = M + 1;
                Ls_temp = Ls_temp + 10^(0.1*specy(pp));
            else
            end
        end
        Ls(ll) = 10*log10((1/M)*Ls_temp) + 10*log10(delta_f/delta_f_e);
        Lg(ll) = Ls(ll) + 10*log10(delta_f_cy(ll)/delta_f);
        Lmhs(ll) = Lg(ll) + avy(ll); % <<< Mithörschwelle für die einzelnen Tonfrequenzen im maskierenden Geräusch == Ziel!!!! :-) >>>
        Ls_temp = 0;
        M = 0;
    end    
    Lmhs_array(:,rr) = Lmhs;
end
assignin('base','Lmhs_array',Lmhs_array);
assignin('base','fy',fy);
close(hWait);


%% GUI plot Mithörschwellen (Geschwindigkeits-Ziele)

cmap = colormap(jet(length(v)));
legendInfo = cell(1,s_col);
figure;
for kk = 1:s_col
    semilogx(fy,Lmhs_array(:,kk),'Color',cmap(kk,:),'LineWidth',2);
    hold on;
    legendInfo{kk} = [num2str(v(kk)) 'km/h'];
end
screen_size = get(0,'ScreenSize');
set(gcf, 'Position', [10 31 0.99*screen_size(3) 0.85*screen_size(4)]);
set(gca,'FontSize',14)
h_legend=legend(legendInfo,'Location','Best');
set(h_legend,'FontSize',10);
grid on; xlabel('Frequenz [Hz]','FontSize',14);ylabel('Mithörschwelle [dB(A)]','FontSize',14);
hold off;


%% Interpolation der IRA-Ziele über der Frequenz (Geschwindigkeits-Ziele)

[vz1,vs1] = size(Lmhs_array);
ZVectorV = [];
ZArrayV = nan(20000,2*length(v)+1);   % Array mit interpolierten Geschwindigkeitszielen
ZArrayV(:,1) = 1:1:20000;

if 1 == 0
else
    hWait = waitbar(0,'Interpoliere und schreibe Mithörschwellen 1Hz ...');
    for ivs1 = 1:vs1 %Spaltenabfrage
        waitbar(ivs1/vs1);
        for ivz1 = 1:vz1 %Zeilenabfrage
            if isnan(Lmhs_array(ivz1,ivs1))
            else
                if ivz1 <= vz1-1 %letzte Zeile ausschließen
                    if ~isnan(Lmhs_array(ivz1,ivs1)) && ~isnan(Lmhs_array(ivz1+1,ivs1)) % raus mit NaN!!!
                        vx = [fy(ivz1,1) fy(ivz1+1,1)];
                        vy = [Lmhs_array(ivz1,ivs1) Lmhs_array(ivz1+1,ivs1)];
                        vxi = ceil(vx(1)):1:floor(vx(2)-10^-10);vxi=vxi';
                        vyi = interp1(vx,vy,vxi);
                    else
                        break
                    end
                else
                    break
                end
                if isempty(ZVectorV)
                    ZVectorV(:,1) = vxi;
                    ZVectorV(:,2) = vyi;
                else
                    vnumx = numel(vxi);
                    vnum = numel(ZVectorV(:,1));
                    ZVectorV(vnum+1:vnum+vnumx,1) = vxi;
                    ZVectorV(vnum+1:vnum+vnumx,2) = vyi;
                end
            end
        end
        
        for iii = 1:length(ZVectorV)
            for jjj = 1:length(ZArrayV)
                if ZVectorV(iii,1) == ZArrayV(jjj,1)
                    if ivs1 == 1
                        ZArrayV(jjj,ivs1+1) = ZVectorV(iii,1);
                        ZArrayV(jjj,ivs1+2) = ZVectorV(iii,2);
                    else
                        ZArrayV(jjj,2*ivs1) = ZVectorV(iii,1);
                        ZArrayV(jjj,2*ivs1+1) = ZVectorV(iii,2);
                    end
                else
                end
            end            
        end        
        ZVectorV = [];
    end
    assignin('base', 'ZArrayV',ZArrayV);
    close(hWait);
end


end